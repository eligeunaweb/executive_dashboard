<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Client Action: this is what renders the OWL component -->
    <record id="action_executive_dashboard" model="ir.actions.client">
        <field name="name">Executive Dashboard</field>
        <field name="tag">executive_dashboard</field>
        <field name="target">main</field>
    </record>

    <!-- Top-level menu -->
    <menuitem
        id="menu_executive_dashboard_root"
        name="Dashboard"
        action="action_executive_dashboard"
        sequence="1"
        web_icon="executive_dashboard,static/description/icon.png"
        groups="executive_dashboard.group_dashboard_user"
    />

</odoo>
