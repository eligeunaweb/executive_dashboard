<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Category -->
        <record id="module_executive_dashboard" model="ir.module.category">
            <field name="name">Executive Dashboard</field>
            <field name="sequence">100</field>
        </record>

        <!-- Groups -->
        <record id="group_dashboard_user" model="res.groups">
            <field name="name">User</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Can view and configure their own dashboard.</field>
        </record>

        <record id="group_dashboard_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="implied_ids" eval="[(4, ref('group_dashboard_user'))]"/>
            <field name="comment">Can view all users' dashboards and manage global settings.</field>
        </record>

    </data>
</odoo>